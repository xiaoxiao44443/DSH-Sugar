<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="text/plain" android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="DSH Sugar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshSugar">
        <activity android:name=".NotificationEntryActivity" android:exported="false"
            android:relinquishTaskIdentity="true" android:theme="@android:style/Theme.NoDisplay" />
        <activity android:name=".PetVoiceCaptureActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="app.dsh.sugar.petvoice"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
        <activity android:name=".DiagnosticsRecoveryActivity" android:exported="false"
            android:theme="@style/RecoveryManagementWindow"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity android:name=".RecoveryBrowserActivity" android:exported="false" android:process=":recovery"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity android:name=".RecoveryProfileEditorActivity" android:exported="false"
            android:theme="@style/RecoveryEditorWindow"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".AdbPairingReply" android:exported="false" />
        <provider
            android:name=".ExternalProfileProvider"
            android:authorities="${applicationId}.profile-edit"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name=".ArtifactViewProvider"
            android:authorities="${applicationId}.artifacts"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name=".workspace.WorkspaceDocumentsProvider"
            android:authorities="${applicationId}.workspaces"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <service
            android:name=".mobile.MobileAccessibilityService"
            android:exported="true"
            android:label="@string/mobile_use_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/sugar_accessibility_service" />
        </service>
        <service
            android:name=".runtime.RuntimeForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hosts the user-started local DSH agent server and its Linux project jobs while the workspace UI is closed." />
        </service>
        <service
            android:name="com.sucrune.probe.RuntimeWorkerService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":runtime_worker" />
    </application>
</manifest>
